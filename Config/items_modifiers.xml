 <set xpath="//item_modifier[@name='modGunCrippleEm']/effect_group[1]/requirement[@name='RandomRoll']/@value">100</set>
<!-- Shotgun case: RandomRoll still using 0-800, changing threshold to 800 = 100% -->
<set xpath="//item_modifier[@name='modGunCrippleEm']/effect_group[2]/requirement[@name='RandomRoll']/@value">800</set>

    <!-- Drum Magazine: change effect to base_add and apply 20x capacity -->
